# Copy this file to .env and fill in local values. Never commit the real .env.
# These are LOCAL DEVELOPMENT credentials only, this database is not exposed
# outside your own machine's Docker network.

POSTGRES_USER=knowledgebridge
POSTGRES_PASSWORD=changeme_local_dev_only
POSTGRES_DB=knowledgebridge
POSTGRES_PORT=5432

# gbrain runs as a container and uses OpenRouter for embeddings and answers.
# Use your own OpenRouter key.
OPENROUTER_API_KEY=paste_your_openrouter_key_here

# The backend's gbrain access token. Create it once gbrain is running:
#   docker compose exec gbrain gbrain auth create knowledgebridge-api
# then paste the gbrain_... value here and restart the backend.
GBRAIN_TOKEN=paste_real_gbrain_token_here
